:root {
  --bg-primary: #0f141c;
  --bg-secondary: #18202c;
  --bg-card: #1e293b;
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --accent-primary: #10b981;
  --accent-hover: #059669;
  --accent-gold: #f59e0b;
  --accent-danger: #ef4444;
  --border-color: #334155;
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

body.theme-light {
  --bg-primary: #f8fafc;
  --bg-secondary: #f1f5f9;
  --bg-card: #ffffff;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --border-color: #cbd5e1;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  background-color: var(--bg-primary);
  color: var(--text-main);
  line-height: 1.5;
  min-height: 100vh;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background-color: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand h1 {
  font-size: 1.25rem;
  font-weight: 700;
}

.logo-badge {
  background-color: var(--accent-primary);
  color: #0f141c;
  font-weight: 800;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
}

.region-pill {
  background: var(--border-color);
  font-size: 0.75rem;
  font-weight: bold;
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
  color: var(--accent-gold);
}

.nav-links {
  display: flex;
  gap: 0.5rem;
}

.nav-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 0.95rem;
  font-weight: 600;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-btn:hover {
  color: var(--text-main);
  background: var(--bg-card);
}

.nav-btn.active {
  color: var(--text-main);
  background: var(--border-color);
}

.btn-primary {
  background: var(--accent-primary);
  color: #0f141c;
  border: none;
  font-weight: 600;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  cursor: pointer;
}

.btn-llm {
  background: #6366f1;
  color: #ffffff;
  border: none;
  font-weight: 600;
  padding: 0.5rem 0.9rem;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-llm:hover {
  background: #4f46e5;
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--text-main);
  border: 1px solid var(--border-color);
  padding: 0.5rem 0.8rem;
  border-radius: 6px;
  cursor: pointer;
}

.status-banner {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 2rem;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  font-size: 0.85rem;
}

.status-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.status-indicator.live {
  background: var(--accent-primary);
  box-shadow: 0 0 8px var(--accent-primary);
}

.staleness {
  margin-left: auto;
  color: var(--text-muted);
}

.main-container {
  padding: 1.5rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.search-box input {
  padding: 0.5rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 6px;
  min-width: 320px;
}

.filter-controls {
  display: flex;
  gap: 1rem;
}

.filter-controls select {
  padding: 0.4rem 0.8rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 6px;
}

.table-responsive {
  overflow-x: auto;
  border: 1px solid var(--border-color);
  border-radius: 8px;
}

.signals-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.signals-table th, .signals-table td {
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--border-color);
}

.signals-table th {
  background: var(--bg-card);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
}

.signals-table tr:hover {
  background: rgba(255, 255, 255, 0.02);
}

.profit-badge {
  color: var(--accent-primary);
  font-weight: 700;
}

.confidence-bar {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 700;
}

.conf-high {
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-primary);
}

.conf-mid {
  background: rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
}

.reasons-tooltip {
  font-size: 0.8rem;
  color: var(--text-muted);
  max-width: 300px;
}

.item-search-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.item-search-row input {
  flex: 1;
  padding: 0.6rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 6px;
}

.item-overview-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.metric-card {
  background: var(--bg-card);
  padding: 1rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.metric-label {
  display: block;
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-bottom: 0.35rem;
}

.metric-val {
  font-size: 1.4rem;
  font-weight: 700;
}

.chart-container {
  background: var(--bg-card);
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.health-card {
  background: var(--bg-card);
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.health-card h4 {
  margin-bottom: 1rem;
}

.health-status.ok {
  color: var(--accent-primary);
  font-weight: 800;
  font-size: 1.2rem;
  margin-bottom: 1rem;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}

.progress-bar {
  background: var(--border-color);
  height: 8px;
  border-radius: 4px;
  overflow: hidden;
  margin: 0.75rem 0;
}

.progress-fill {
  background: var(--accent-primary);
  height: 100%;
}

.commission-badge {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-primary);
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-weight: 600;
  font-size: 0.8rem;
}

.watchlist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.watchlist-actions {
  display: flex;
  gap: 0.5rem;
}

.module-builder-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 1.5rem;
  border-radius: 8px;
  margin-bottom: 2rem;
}

.module-builder-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}

.builder-badge {
  background: var(--accent-gold);
  color: #0f141c;
  font-size: 0.75rem;
  font-weight: 800;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
}

.module-selectors {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1rem;
  align-items: flex-end;
}

.module-selectors label {
  display: flex;
  flex-direction: column;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.module-selectors select, .module-selectors input {
  margin-top: 0.35rem;
  padding: 0.5rem 0.75rem;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 6px;
}

.search-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.quick-cat-filters {
  display: flex;
  gap: 0.5rem;
}

.cat-pill {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  padding: 0.35rem 0.8rem;
  border-radius: 20px;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s;
}

.cat-pill.active {
  background: var(--accent-primary);
  color: #0f141c;
  font-weight: 700;
}

.catalog-search-bar input {
  width: 100%;
  padding: 0.75rem 1.25rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 8px;
  font-size: 1rem;
  margin-bottom: 1.5rem;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1rem;
}

.catalog-item-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 0.75rem 1rem;
  border-radius: 8px;
  gap: 1rem;
}

.card-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 6px;
}

.card-icon img {
  max-width: 40px;
  max-height: 40px;
}

.card-info {
  flex: 1;
}

.card-title {
  font-weight: 600;
  font-size: 0.95rem;
  margin-bottom: 0.25rem;
}

.card-meta {
  display: flex;
  gap: 0.5rem;
  font-size: 0.75rem;
  align-items: center;
}

.rank-badge {
  padding: 0.1rem 0.4rem;
  border-radius: 3px;
  font-weight: bold;
  background: #334155;
  color: #e2e8f0;
}

.rank-badge.RANK_STALKER { background: #2563eb; }
.rank-badge.RANK_VETERAN { background: #7c3aed; }
.rank-badge.RANK_MASTER { background: #db2777; }
.rank-badge.RANK_LEGEND { background: #ea580c; }

.override-pill {
  background: rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
  padding: 0.1rem 0.4rem;
  border-radius: 3px;
  font-size: 0.7rem;
}

.btn-track {
  font-size: 0.85rem;
  padding: 0.4rem 0.8rem;
}

.status-pill {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 700;
}

.status-pill.active {
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-primary);
}

.status-pill.paused {
  background: rgba(148, 163, 184, 0.2);
  color: var(--text-muted);
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.8rem;
  border-radius: 4px;
  cursor: pointer;
}

.btn-danger {
  background: rgba(239, 68, 68, 0.2);
  color: var(--accent-danger);
  border: 1px solid var(--accent-danger);
}

.mt-3 {
  margin-top: 1rem;
}

.config-view pre {
  background: var(--bg-card);
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  overflow-x: auto;
  font-size: 0.9rem;
}
