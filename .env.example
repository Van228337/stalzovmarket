# STALCRAFT API Credentials
# Approved app credentials (leave empty if testing on demo)
STALCRAFT_CLIENT_ID=
STALCRAFT_CLIENT_SECRET=

# Base URLs
STALCRAFT_API_BASE_URL=https://eapi.stalcraft.net
STALCRAFT_DEMO_API_BASE_URL=https://dapi.stalcraft.net

# Regions: RU, EU, NA, SEA, NEA
STALCRAFT_REGION=RU

# Supabase Credentials (PostgreSQL / PostgREST)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free LLM API (optional)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-1.5-flash
